generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Perfil {
  LEITOR
  BIBLIOTECARIO
}

enum SituacaoExemplar {
  DISPONIVEL
  EMPRESTADO
  RESERVADO
  INDISPONIVEL
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  perfil   Perfil   @default(LEITOR)
  criadoEm DateTime @default(now())

  @@map("usuario")
}

model Livro {
  id            Int        @id @default(autoincrement())
  titulo        String
  autor         String
  isbn          String     @unique
  ano           Int
  editora       String?
  categoria     String?
  sinopse       String?
  numeroPaginas Int?
  capa          String?
  criadoEm      DateTime   @default(now())
  exemplares    Exemplar[]

  @@map("livro")
}

model Exemplar {
  id       Int              @id @default(autoincrement())
  codigo   String           @unique
  situacao SituacaoExemplar @default(DISPONIVEL)
  livroId  Int
  livro    Livro            @relation(fields: [livroId], references: [id])
  criadoEm DateTime         @default(now())

  @@map("exemplar")
}
