generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Perfil {
  LEITOR
  BIBLIOTECARIO
}

enum SituacaoExemplar {
  DISPONIVEL
  EMPRESTADO
  RESERVADO
  INDISPONIVEL
}

enum SituacaoReserva {
  AGUARDANDO
  ATENDIDA
  CANCELADA
}

enum TipoMovimentacao {
  EMPRESTIMO
  DEVOLUCAO
  RESERVA
  RESERVA_ATENDIDA
  RESERVA_CANCELADA
}

model Usuario {
  id             Int            @id @default(autoincrement())
  nome           String
  email          String         @unique
  perfil         Perfil         @default(LEITOR)
  criadoEm       DateTime       @default(now())
  emprestimos    Emprestimo[]
  reservas       Reserva[]
  movimentacoes  Movimentacao[]

  @@map("usuario")
}

model Livro {
  id            Int        @id @default(autoincrement())
  titulo        String
  autor         String
  isbn          String     @unique
  ano           Int
  editora       String?
  categoria     String?
  sinopse       String?
  numeroPaginas Int?
  capa          String?
  criadoEm      DateTime   @default(now())
  exemplares     Exemplar[]
  reservas       Reserva[]
  movimentacoes  Movimentacao[]

  @@map("livro")
}

model Exemplar {
  id          Int              @id @default(autoincrement())
  codigo      String           @unique
  situacao    SituacaoExemplar @default(DISPONIVEL)
  livroId     Int
  livro       Livro            @relation(fields: [livroId], references: [id])
  criadoEm    DateTime         @default(now())
  emprestimos    Emprestimo[]
  movimentacoes  Movimentacao[]

  @@map("exemplar")
}

model Emprestimo {
  id           Int       @id @default(autoincrement())
  exemplarId   Int
  exemplar     Exemplar  @relation(fields: [exemplarId], references: [id])
  leitorId     Int
  leitor       Usuario   @relation(fields: [leitorId], references: [id])
  emprestadoEm DateTime  @default(now())
  previstoPara DateTime
  devolvidoEm  DateTime?
  multa        Float?

  @@index([leitorId])
  @@index([devolvidoEm])
  @@map("emprestimo")
}

model Reserva {
  id         Int             @id @default(autoincrement())
  livroId    Int
  livro      Livro           @relation(fields: [livroId], references: [id])
  leitorId   Int
  leitor     Usuario         @relation(fields: [leitorId], references: [id])
  situacao   SituacaoReserva @default(AGUARDANDO)
  criadoEm   DateTime        @default(now())
  atendidaEm DateTime?

  @@index([livroId, situacao, criadoEm])
  @@map("reserva")
}

model Movimentacao {
  id         Int               @id @default(autoincrement())
  livroId    Int
  livro      Livro             @relation(fields: [livroId], references: [id], onDelete: Cascade)
  exemplarId Int?
  exemplar   Exemplar?         @relation(fields: [exemplarId], references: [id], onDelete: SetNull)
  leitorId   Int?
  leitor     Usuario?          @relation(fields: [leitorId], references: [id], onDelete: SetNull)
  tipo       TipoMovimentacao
  data       DateTime
  detalhe    String?
  multa      Float?
  criadoEm   DateTime          @default(now())

  @@index([livroId, data])
  @@map("movimentacao")
}
